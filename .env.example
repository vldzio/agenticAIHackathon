# Copy to backend/.env for local development. Every variable is optional.
# NOTE: there is intentionally no Gemini key here. Live mode is bring-your-own-key:
# each visitor supplies their own key in the browser (sent per request, never stored).

AETHERFIT_ENV=dev                       # "prod" enables production behaviour
AETHERFIT_LOG_LEVEL=INFO
AETHERFIT_DATABASE_URL=sqlite:///./var/aetherfit.db
AETHERFIT_CORS_ORIGINS=http://localhost:5173,http://localhost:8080   # comma-separated or JSON list

# Abuse protection (in-process; use a shared limiter for multi-replica deployments)
AETHERFIT_RATE_LIMIT_PER_MINUTE=120
AETHERFIT_ASSESSMENT_RATE_LIMIT_PER_MINUTE=10
AETHERFIT_MAX_REQUEST_BYTES=64000
AETHERFIT_TRUST_PROXY_HEADERS=false     # true only when behind a proxy you control

# Gemini (live mode)
AETHERFIT_GEMINI_MODEL=gemini-2.5-flash-lite
AETHERFIT_LLM_TIMEOUT_SECONDS=45
AETHERFIT_LLM_MAX_RETRIES=3

# Refuse to load model artifacts trained with different scikit-learn/numpy/pandas versions
AETHERFIT_STRICT_MODEL_VERSIONS=false

# Frontend dev server only (frontend/.env.local)
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
